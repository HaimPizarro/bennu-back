PORT=3000
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opcional: clave service role de Supabase (Settings -> API keys).
# Se usa para avisar en el registro si un email ya tiene cuenta y con qué
# proveedor fue creada (Google vs email/contraseña). Si no se configura, el
# registro muestra un aviso genérico sin distinguir el proveedor.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar sync (opcional): crea credenciales OAuth2 en Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# URL del frontend para redireccionar tras conectar Google
FRONTEND_URL=http://localhost:5173

# Mercado Pago (Checkout Pro). Token de PRUEBA de la cuenta que RECIBE el dinero.
# Fase actual: la dueña cobra el 100% => usar el Access Token de su cuenta MP.
MERCADOPAGO_ACCESS_TOKEN=

# Moneda del cobro (CLP si la cuenta MP opera en Chile).
MERCADOPAGO_CURRENCY=CLP

# URL pública del webhook (en dev, tunel ngrok/cloudflared hacia el backend).
# Ej: https://xxxx.ngrok.app/api/pagos/webhook
MERCADOPAGO_WEBHOOK_URL=

# Emails de confirmación de cita. Proveedor intercambiable por env:
# - Hover con Gmail: completar EMAIL_FROM (tu Gmail) + SMTP_USER/PASS
#   (contraseña de aplicación, NO la de la cuenta).
# - Para pasar a Resend: completar solo RESEND_API_KEY + EMAIL_FROM (dominio verificado).
EMAIL_FROM_NAME=bennu
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
